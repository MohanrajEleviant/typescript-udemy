# Example Real-Time Framework Utility

```ts id="pted1g"
async function verifyElements(
    timeout:number = 5000,
    ...locators:string[]
): Promise<void> {

    for (const locator of locators) {

        await expect(
            page.locator(locator)
        ).toBeVisible({
            timeout
        });
    }
}
```

